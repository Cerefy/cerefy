rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSameTenant(tenantId) {
      return isSignedIn() && getUserData().tenantId == tenantId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'tenantId'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.role is string && data.role in ['SUPER_ADMIN', 'TENANT_ADMIN', 'ANALYST', 'VIEWER']
        && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128;
    }

    // Agent entity validation
    function isValidAgent(data) {
      return data.keys().hasAll(['id', 'tenantId', 'name', 'role', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.role is string && data.role.size() > 0 && data.role.size() <= 128
        && data.status is string && data.status in ['IDLE', 'RUNNING', 'FAILED', 'SUCCESS', 'idle', 'busy', 'reflecting', 'offline'];
    }

    // Log entity validation
    function isValidLog(data) {
      return data.keys().hasAll(['id', 'tenantId', 'agentId', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128
        && data.agentId is string && data.agentId.size() > 0 && data.agentId.size() <= 128
        && data.status is string && data.status in ['SUCCESS', 'FAILED', 'RUNNING', 'WARNING'];
    }

    // MemoryItem entity validation
    function isValidMemory(data) {
      return data.keys().hasAll(['id', 'tenantId', 'content'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128
        && data.content is string && data.content.size() > 0 && data.content.size() <= 1000000;
    }

    // --- Collections ---

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().tenantId == existing().tenantId; // Prevent tenant jumping
      allow delete: if false;
    }

    // Agents Collection
    match /agents/{agentId} {
      allow read: if isSameTenant(resource.data.tenantId);
      allow create: if isSameTenant(incoming().tenantId) && isValidAgent(incoming());
      allow update: if isSameTenant(existing().tenantId) 
        && isSameTenant(incoming().tenantId)
        && isValidAgent(incoming());
      allow delete: if isSameTenant(existing().tenantId);
    }

    // Logs Collection
    match /logs/{logId} {
      allow read: if isSameTenant(resource.data.tenantId);
      allow create: if isSameTenant(incoming().tenantId) && isValidLog(incoming());
      allow update: if isSameTenant(existing().tenantId)
        && isSameTenant(incoming().tenantId)
        && isValidLog(incoming());
      allow delete: if isSameTenant(existing().tenantId);
    }

    // Memories Collection
    match /memories/{memoryId} {
      allow read: if isSameTenant(resource.data.tenantId);
      allow create: if isSameTenant(incoming().tenantId) && isValidMemory(incoming());
      allow update: if isSameTenant(existing().tenantId)
        && isSameTenant(incoming().tenantId)
        && isValidMemory(incoming());
      allow delete: if isSameTenant(existing().tenantId);
    }
  }
}
