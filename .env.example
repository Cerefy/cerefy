# ============================================================
# Cerefy Enterprise AI — Environment Variables
# Copy this file to .env and fill in your values
# See ENVIRONMENT.md for full documentation
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:3002

# ─── Database (PostgreSQL + pgvector) ────────────────────────
DB_USER=cerefy
DB_PASSWORD=cerefy_dev_password
DB_NAME=cerefy_dev
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ─── Neo4j Knowledge Graph ───────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cerefy_neo4j_dev

# ─── AI Providers ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cerefy
LANGSMITH_TRACING=true

# ─── GitHub Automation ───────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=Cerefy
GITHUB_REPO=cerefy

# ─── Observability ────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# ─── Cloudflare ──────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# ─── Qdrant Vector Search ────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=cerefy-memory

# ─── Temporal Workflows ──────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cerefy-ai

# ─── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=cerefy-dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=cerefy-dev-refresh-secret-change-in-production

# ─── Firebase Admin ──────────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Optional Services ───────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# RABBITMQ_URL=amqp://cerefy:cerefy_mq_pass@localhost:5672
