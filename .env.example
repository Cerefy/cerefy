# Server Settings
PORT=4000
NODE_ENV=development

# Database Settings
DATABASE_URL="postgresql://cerefy:cerefy_secret_pass@localhost:5432/cerefy_db?schema=public"

# Authentication Secrets
JWT_SECRET="cerefy-super-secret-jwt-key-2026"
JWT_REFRESH_SECRET="cerefy-refresh-token-secret-2026"

# Enterprise Vector & Graph Databases
QDRANT_URL="http://localhost:6333"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="cerefy_neo4j_pass"

# Redis Cache & Broker
REDIS_HOST="localhost"
REDIS_PORT=6379

# RabbitMQ Event Bus
RABBITMQ_URL="amqp://cerefy:cerefy_mq_pass@localhost:5672"
